{
  "shared": ["lib/**"],
  "rules": {"crap": {
    "limit": 8,
    "sharedLimit": 4
  }},
  "godeps": {
    "title": "godeps fixture page",
    "archGoReport": ".arch-go/report.json",
    "crapReport": "crap.json",
    "dupReport": "dup.json",
    "foreign": ["example.com/lib"],
    "omit": ["gen"],
    "order": ["shared"]
  }
}
